# Copy to .env and fill only the providers you use.
# Never commit .env or real credentials.

ENVIRONMENT=development
DEBUG=false

# Model provider selection: groq, gemini, anthropic, or local.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_API_KEY=local-development-key

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
WS_HEARTBEAT_SECONDS=20
WS_MAX_MESSAGE_BYTES=65536
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH_BYTES=2

REDIS_URL=redis://localhost:6379/0
MEMORY_REDIS_REQUIRED=false
MEMORY_MAX_TURNS=15
MEMORY_MAX_TOKENS=4000
MEMORY_TTL_SECONDS=86400
MEMORY_CANCEL_TTL_SECONDS=300
MEMORY_SUMMARY_MAX_CHARS=2000
MEMORY_MAX_MESSAGE_CHARS=32000
POSTGRES_DSN=postgresql+asyncpg://voice_agent:voice_agent@localhost:5432/voice_agent
CHROMA_PATH=data/chroma

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
REQUIRE_EXTERNAL_SERVICES=false
TOOL_EXECUTION_TIMEOUT_SECONDS=15
MAX_TOOL_CALLS_PER_TURN=4
TOOLS_ENABLED=false
WORKSPACE_ROOTS=[]
WORKSPACE_MAX_LIST_RESULTS=100
WORKSPACE_MAX_SEARCH_FILE_BYTES=1000000
WORKSPACE_MAX_READ_BYTES=256000
WORKSPACE_MAX_READ_LINES=300
WORKSPACE_MAX_WRITE_BYTES=256000
WORKSPACE_TRASH_DIR=.voice_agent_trash
WORKSPACE_GIT_TIMEOUT_SECONDS=15
WORKSPACE_ALLOWED_EXTENSIONS=[]
WORKSPACE_SECRET_FILE_PATTERNS=[".env", "*.pem", "*.key", "*secret*", "*credential*", "id_rsa", "id_ed25519"]
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
WEB_ALLOWED_DOMAINS=[]
WEB_MAX_RESULTS=10
WEB_MAX_RESPONSE_BYTES=1000000
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_USER_AGENT=RealTimeVoiceAgent/1.0
GOOGLE_ACCESS_TOKEN=
GOOGLE_API_BASE_URL=https://www.googleapis.com
GOOGLE_TIMEOUT_SECONDS=15
GOOGLE_MAX_RESULTS=20
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_OAUTH_ENCRYPTION_KEY=
GOOGLE_TOKEN_DB_PATH=data/google_tokens.sqlite3
GRAPH_ACCESS_TOKEN=
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_TIMEOUT_SECONDS=15
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft/callback
MICROSOFT_OAUTH_AUTHORIZE_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_OAUTH_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
MICROSOFT_TOKEN_DB_PATH=data/microsoft_tokens.sqlite3
INTEGRATION_TIMEOUT_SECONDS=15
ESP32_BASE_URL=
ESP32_API_KEY=
MERN_API_BASE_URL=
MERN_API_KEY=
TELEPHONY_TIMEOUT_SECONDS=15
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=https://api.twilio.com/2010-04-01
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_ALLOWED_DESTINATIONS=[]
WS_RATE_LIMIT_PER_MINUTE=600
WS_MAX_CONNECTIONS_PER_USER=4
VAD_SPEECH_ONSET_FRAMES=2
VAD_SILENCE_HANGOVER_FRAMES=5

TELEMETRY_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=real-time-voice-agent
