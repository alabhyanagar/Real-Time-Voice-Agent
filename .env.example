# Copy to .env and fill only the providers you use.
# Never commit .env or real credentials.

ENVIRONMENT=development
DEBUG=false

# Model provider selection: groq, gemini, anthropic, or local.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_API_KEY=local-development-key

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
WS_HEARTBEAT_SECONDS=20
WS_MAX_MESSAGE_BYTES=65536
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH_BYTES=2

REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://voice_agent:voice_agent@localhost:5432/voice_agent
CHROMA_PATH=data/chroma

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
REQUIRE_EXTERNAL_SERVICES=false
TOOL_EXECUTION_TIMEOUT_SECONDS=15
MAX_TOOL_CALLS_PER_TURN=4
WS_RATE_LIMIT_PER_MINUTE=600
WS_MAX_CONNECTIONS_PER_USER=4
VAD_SPEECH_ONSET_FRAMES=2
VAD_SILENCE_HANGOVER_FRAMES=5

TELEMETRY_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=real-time-voice-agent
